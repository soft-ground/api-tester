# ============================================================
# Environment variable sample — copy this file to .env and edit it.
#   cp .env.example .env   (Windows PowerShell: Copy-Item .env.example .env)
# .env is never committed to git (see .gitignore).
# ============================================================

# --- PostgreSQL connection ---
# docker-compose initializes the db container with these values and
# assembles the server's DATABASE_URL automatically.
POSTGRES_USER=apitester
POSTGRES_PASSWORD=change_me     # change this to your own value, even for local use
POSTGRES_DB=apitester

# Note: the server container's DATABASE_URL is composed from the three values
# above in docker-compose.yml. You do not need to set it manually.
# postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@db:5432/${POSTGRES_DB}?schema=public
